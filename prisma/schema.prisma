generator client {
  provider = "prisma-client"
  output   = "../src/db/generated"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            Int            @id @default(autoincrement())
  username      String         @unique @db.VarChar(30)
  passwordHash  String         @db.VarChar(100)
  refreshTokens RefreshToken[]
  firstName     String         @db.VarChar(50)
  lastName      String         @db.VarChar(50)
  avatarId      String?        @unique @db.Uuid
  reports       Report[]
  pitReports    PitReport[]
}

model RefreshToken {
  value     String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
  expiresAt DateTime
}

model Report {
  id                   Int       @id @default(autoincrement())
  user                 User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId               Int?
  createdAt            DateTime
  eventCode            String    @db.Char(5)
  matchType            MatchType
  matchNumber          Int       @db.SmallInt
  alliance             Alliance
  teamNumber           Int       @db.SmallInt
  inMatch              Boolean
  notes                String    @db.VarChar(400)
  minorFouls           Int       @db.SmallInt
  majorFouls           Int       @db.SmallInt
  secondsIncapacitated Int       @db.SmallInt
  shootingConfidence   Int       @db.SmallInt

  autoHubScores Int       @db.SmallInt
  autoHubMisses Int       @db.SmallInt
  autoClimb     AutoClimb
  autoPasses    Int       @db.SmallInt
  autoNotes     String    @db.VarChar(400)

  teleopHubScores   Int     @db.SmallInt
  teleopHubMisses   Int     @db.SmallInt
  teleopPasses      Int     @db.SmallInt
  teleopDefended    Boolean
  teleopWasDefended Boolean
  teleopNotes       String  @db.VarChar(400)

  endgameLevel       Int     @db.SmallInt
  endgameClimbFailed Boolean
  endgameNotes       String  @db.VarChar(400)

  @@unique([matchNumber, teamNumber])
}

enum MatchType {
  QUALIFICATION
  PLAYOFF
}

enum Alliance {
  RED
  BLUE
}

enum StartingPosition {
  LEFT
  LEFT_BUMP
  LEFT_TRENCH
  CENTER
  RIGHT
  RIGHT_BUMP
  RIGHT_TRENCH
}

enum AutoClimb {
  NONE
  LEVEL1
  FAILED
}

// Types of robots:
// cleanup - scoring from one spot
// ferrying
// shoveling
// defense
// cycle - go to neutral, go back, and score

model PitReport {
  id             Int           @id @default(autoincrement())
  user           User          @relation(fields: [userId], references: [id])
  userId         Int
  createdAt      DateTime
  eventCode      String        @db.Char(5)
  teamNumber     Int           @db.SmallInt
  drivetrain     Drivetrain
  shooter        Shooter
  estimatedBps   Decimal?
  hopperCapacity Int           @db.SmallInt
  climbLevel     Int           @db.SmallInt
  canPass        Boolean
  canDefend      Boolean
  canCrossBump   Boolean
  canCrossTrench Boolean
  autoRoutines   AutoRoutine[]
  // According to Adrian, we don't have enough aura to be asking for driver
  // hours.
  driverEvents   Int           @db.SmallInt
  weightLbs      Decimal
  notes          String        @db.VarChar(400)
  photoId        String?       @unique @db.Uuid
}

enum Drivetrain {
  SWERVE
  TANK
  MECANUM
}

enum Shooter {
  SINGLE
  DUAL
  TRIPLE
  QUAD
  TURRET
  DUAL_TURRET
  DRUM
  OTHER
}

enum Indexer {
  VERTICAL
  SPINDEXER
  ROLLER
  BELT
  GRAVITY
}

model AutoRoutine {
  id                Int              @id @default(autoincrement())
  report            PitReport        @relation(fields: [reportId], references: [id])
  reportId          Int
  startingPosition  StartingPosition
  actions           AutoAction[]
  expectedHubScores Int              @db.SmallInt
}

enum AutoAction {
  COLLECT_DEPOT
  COLLECT_OUTPOST
  CROSS_LEFT_BUMP
  CROSS_LEFT_TRENCH
  CROSS_RIGHT_BUMP
  CROSS_RIGHT_TRENCH
  SHOOT
  CLIMB
}
