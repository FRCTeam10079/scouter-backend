{
  "name": "scouter-backend",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "setup": "node setup.js",
    "setup:prod": "node setup.js --prod",
    "dev": "cross-env NODE_ENV=development tsx --env-file=.env src/index.ts",
    "dev:watch": "cross-env NODE_ENV=development tsx watch --env-file=.env src/index.ts",
    "build": "tsc -p tsconfig.prod.json && tsc-alias -p tsconfig.prod.json",
    "start": "cross-env NODE_ENV=production node --env-file=.env build/index.js",
    "reset-db": "tsx --env-file=.env reset-db.ts",
    "check": "biome check",
    "check:fix": "biome check --write",
    "test": "cross-env NODE_ENV=test tsx --test --env-file=.env **/*.test.ts",
    "test:watch": "cross-env NODE_ENV=test tsx --test --watch --env-file=.env **/*.test.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/jwt": "^10.2.0",
    "@fastify/multipart": "^10.1.0",
    "@node-rs/argon2": "^2.0.2",
    "drizzle-kit": "1.0.0-rc.4",
    "drizzle-orm": "1.0.0-rc.4",
    "drizzle-seed": "1.0.0-rc.4",
    "fastify": "^5.10.0",
    "fastify-type-provider-zod": "^7.0.0",
    "openai": "^6.49.0",
    "pg": "^8.22.0",
    "pino-pretty": "^13.1.3",
    "sharp": "^0.35.3",
    "tslib": "^2.8.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "@types/node": "^26.1.1",
    "@types/pg": "^8.20.0",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "node-cron": "^4.6.0",
    "tsc-alias": "^1.9.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  }
}
